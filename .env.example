# ==========================================
# CYRUS Environment Configuration Template
# Copy this file to .env before starting services
# ==========================================

# --- APPLICATION SETTINGS ---
CYRUS_ENV=development
CYRUS_DEBUG=true
CYRUS_APP_NAME="CYRUS (Cybernetic Yet Responsive Unified System)"
CYRUS_VERSION="0.1.0"
CYRUS_BACKEND_PORT=8000
CYRUS_BACKEND_HOST=127.0.0.1
CYRUS_FRONTEND_PORT=5173

# --- SECURITY & AUTHENTICATION ---
CYRUS_SECRET_KEY="generate-a-secure-random-key-here"
CYRUS_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
CYRUS_SANDBOX_PATH="/Users/sakshamsrivastava/Downloads/CYRUS"

# --- LOCAL DATABASE (SQLITE) ---
CYRUS_DATABASE_URL="sqlite+aiosqlite:///data/cyrus.db"
CYRUS_DB_WAL_MODE=true

# --- LOCAL AI RUNTIME (OLLAMA) ---
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_DEFAULT_MODEL="qwen2.5:7b-instruct"
OLLAMA_FALLBACK_MODEL="qwen2.5:3b-instruct"
OLLAMA_TIMEOUT_SECONDS=60

# --- MANDATORY LANGUAGE GOVERNANCE ---
DEFAULT_RESPONSE_LANGUAGE="English"
INPUT_LANGUAGE_DETECTION="Automatic"
SUPPORTED_INPUT_LANGUAGES=["English", "Hindi", "Hinglish"]
ALLOW_HINDI_RESPONSES=false

# --- LIFECYCLE & PROCESS MANAGEMENT ---
ENABLE_AUTO_START=false
PROCESS_CHECK_INTERVAL_SECONDS=5
SHUTDOWN_GRACE_PERIOD_SECONDS=3

# --- MONITORING (PHASE 9+) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
